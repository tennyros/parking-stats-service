<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="create-parking-transaction-table" author="vadim_23">
        <createTable tableName="parking_transactions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="car_id" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="spot_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="entry_time" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="exit_time" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="parking_transactions"
                baseColumnNames="car_id"
                referencedTableName="cars"
                referencedColumnNames="license_plate"
                constraintName="fk_transaction_car"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableName="parking_transactions"
                baseColumnNames="spot_id"
                referencedTableName="parking_spots"
                referencedColumnNames="id"
                constraintName="fk_transaction_spot"
                onDelete="CASCADE"/>

        <comment>Create parking_transaction table with relations</comment>
    </changeSet>

</databaseChangeLog>